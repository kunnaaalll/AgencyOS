      "targets": [
        {
          "expr": "increase(agencyos_leads_created_total[24h])",
          "legendFormat": "Leads"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Discovery Jobs (24h)",
      "type": "stat",
