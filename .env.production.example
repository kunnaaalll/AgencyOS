# ============================================================
# AgencyOS V2.1 — Production Environment Configuration
# ============================================================
# Copy to .env.production and fill in production values.
# NEVER commit this file to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=production
APP_NAME=AgencyOS
APP_VERSION=2.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ── Database (PostgreSQL) ────────────────────────────────────
# Use a strong password (min 24 chars, mixed case, numbers, symbols)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agencyos
POSTGRES_USER=agencyos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD_HERE
DATABASE_URL=postgresql+asyncpg://agencyos:CHANGE_ME_STRONG_POSTGRES_PASSWORD_HERE@postgres:5432/agencyos

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_HERE
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD_HERE@redis:6379/0

# ── JWT Authentication ───────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1

# ── MinIO (Object Storage) ───────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=agencyos
MINIO_SECURE=false

# ── Meilisearch ──────────────────────────────────────────────
# Generate with: openssl rand -hex 16
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME_MEILISEARCH_MASTER_KEY

# ── Security ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
# Generate with: openssl rand -hex 32
CSRF_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────
# Only your frontend domain — no wildcards
CORS_ORIGINS=https://app.yourdomain.com

# ── Traefik ──────────────────────────────────────────────────
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_ACME_EMAIL=admin@yourdomain.com
DOMAIN=yourdomain.com

# ── Alerting (Telegram) ──────────────────────────────────────
# Create bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Seed Configuration ───────────────────────────────────────
SEED_SUPERADMIN_EMAIL=admin@yourdomain.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS_WITH_COMPLEXITY
SEED_SUPERADMIN_FIRST_NAME=Super
SEED_SUPERADMIN_LAST_NAME=Admin
SEED_ORGANIZATION_NAME=AgencyOS

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
