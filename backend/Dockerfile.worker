# ============================================================
# AgencyOS V2 — Worker Dockerfile (ARQ + Playwright)
# Separate image for background workers that need browser automation
# ============================================================

FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.7 /uv /usr/local/bin/uv

# ── Builder Stage ─────────────────────────────────────────────
FROM base AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv venv /opt/venv && \
    uv pip install --python /opt/venv/bin/python --no-cache .

# Install Playwright browsers
RUN /opt/venv/bin/playwright install --with-deps chromium

# ── Development Stage ─────────────────────────────────────────
FROM base AS development

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv pip install --system --no-cache -e ".[dev]"
RUN playwright install --with-deps chromium

COPY . .

CMD ["arq", "workers.worker.WorkerSettings"]

# ── Production Stage ──────────────────────────────────────────
FROM base AS production

# Install Playwright runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libatspi2.0-0 \
    libgtk-3-0 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
# Copy Playwright browsers from builder
COPY --from=builder /root/.cache/ms-playwright /home/agencyos/.cache/ms-playwright

ENV PATH="/opt/venv/bin:$PATH"

COPY . .

# Create non-root user
RUN groupadd -r agencyos && useradd -r -g agencyos -d /app -s /sbin/nologin agencyos && \
    chown -R agencyos:agencyos /app && \
    chown -R agencyos:agencyos /home/agencyos

USER agencyos

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep -f "arq" || exit 1

CMD ["arq", "workers.worker.WorkerSettings"]
