# ============================================================
# AgencyOS V2 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=AgencyOS
APP_VERSION=2.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agencyos
POSTGRES_USER=agencyos
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql+asyncpg://agencyos:change_me_postgres_password@postgres:5432/agencyos

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=change_me_jwt_secret_minimum_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MinIO (Object Storage) ───────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET_NAME=agencyos
MINIO_SECURE=false

# ── Meilisearch ──────────────────────────────────────────────
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=change_me_meilisearch_master_key

# ── Traefik ──────────────────────────────────────────────────
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# ── Seed Configuration ───────────────────────────────────────
SEED_SUPERADMIN_EMAIL=admin@agencyos.io
SEED_SUPERADMIN_PASSWORD=change_me_superadmin_password
SEED_SUPERADMIN_FIRST_NAME=Super
SEED_SUPERADMIN_LAST_NAME=Admin
SEED_ORGANIZATION_NAME=AgencyOS

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
